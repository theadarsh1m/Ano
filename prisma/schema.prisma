generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String          @id
  nickname              String
  createdAt             DateTime        @default(now())
  lastSeen              DateTime        @default(now())
  avatar                String?
  bio                   String?
  email                 String?         @unique
  googleId              String?         @unique
  isAnonymous           Boolean         @default(true)
  isOnline              Boolean         @default(false)
  nsfwMode              NsfwMode        @default(HIDE)
  presenceStatus        String?
  role                  UserRole        @default(USER)
  isBanned              Boolean         @default(false)
  comments              Comment[]       @relation("CommentAuthor")
  conversationsAsA      Conversation[]  @relation("ParticipantA")
  conversationsAsB      Conversation[]  @relation("ParticipantB")
  sentDMs               DirectMessage[] @relation("DMSender")
  friendshipsAsFriend   Friendship[]    @relation("FriendshipFriend")
  friendshipsAsUser     Friendship[]    @relation("FriendshipUser")
  gameStats             GameStat[]
  messages              Message[]
  notificationsReceived Notification[]  @relation("NotificationRecipient")
  notificationsSent     Notification[]  @relation("NotificationSender")
  posts                 Post[]          @relation("PostAuthor")
  savedPosts            SavedPost[]     @relation("UserSavedPosts")
  votes                 Vote[]          @relation("UserVotes")
  reviews               Review[]
  bugReports            BugReport[]
  reportsSent           UserReport[]    @relation("ReportedBy")
  reportsReceived       UserReport[]    @relation("ReportedUser")
}

model Room {
  id            String         @id
  name          String
  description   String?
  type          String         @default("public")
  inviteCode    String?        @unique
  capacity      Int            @default(50)
  createdAt     DateTime       @default(now())
  createdBy     String?
  messages      Message[]
  voiceChannels VoiceChannel[]
}

model VoiceChannel {
  id        String   @id @default(uuid())
  name      String
  roomId    String
  capacity  Int      @default(25)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Message {
  id                    String           @id
  content               String
  type                  String           @default("text")
  createdAt             DateTime         @default(now())
  senderId              String?
  roomId                String
  fileName              String?
  fileSize              Int?
  fileType              String?
  fileUrl               String?
  moderationStatus      ModerationStatus @default(PENDING_MODERATION)
  moderationProvider    String           @default("Sightengine")
  nudityScore           Float?
  goreScore             Float?
  rawModerationResponse Json?
  moderatedAt           DateTime?
  room                  Room             @relation(fields: [roomId], references: [id])
  sender                User?            @relation(fields: [senderId], references: [id])
}

model Conversation {
  id             String          @id @default(uuid())
  participantAId String
  participantBId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  participantA   User            @relation("ParticipantA", fields: [participantAId], references: [id])
  participantB   User            @relation("ParticipantB", fields: [participantBId], references: [id])
  messages       DirectMessage[]

  @@unique([participantAId, participantBId])
}

model DirectMessage {
  id                    String           @id @default(uuid())
  content               String
  type                  String           @default("text")
  createdAt             DateTime         @default(now())
  senderId              String
  conversationId        String
  fileUrl               String?
  fileName              String?
  fileSize              Int?
  fileType              String?
  isRead                Boolean          @default(false)
  moderationStatus      ModerationStatus @default(PENDING_MODERATION)
  moderationProvider    String           @default("Sightengine")
  nudityScore           Float?
  goreScore             Float?
  rawModerationResponse Json?
  moderatedAt           DateTime?
  conversation          Conversation     @relation(fields: [conversationId], references: [id])
  sender                User             @relation("DMSender", fields: [senderId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  senderId    String?
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id])
  user      User     @relation("FriendshipUser", fields: [userId], references: [id])

  @@unique([userId, friendId])
}

model GameStat {
  id                   String   @id @default(uuid())
  userId               String
  gameType             String
  highScore            Int      @default(0)
  totalPlayTimeSeconds Int      @default(0)
  lastPlayed           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  extraStats           Json?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType])
}

model Post {
  id                    String           @id @default(uuid())
  content               String?
  imageUrl              String?
  isAnonymous           Boolean          @default(false)
  score                 Int              @default(0)
  authorId              String
  tags                  String[]         @default([])
  commentCount          Int              @default(0)
  isLocked              Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  moderationStatus      ModerationStatus @default(PENDING_MODERATION)
  moderationProvider    String           @default("Sightengine")
  nudityScore           Float?
  goreScore             Float?
  rawModerationResponse Json?
  moderatedAt           DateTime?
  comments              Comment[]
  author                User             @relation("PostAuthor", fields: [authorId], references: [id])
  savedBy               SavedPost[]
  votes                 Vote[]
}

model Comment {
  id          String    @id @default(uuid())
  content     String
  isAnonymous Boolean   @default(false)
  authorId    String
  postId      String
  parentId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation("CommentAuthor", fields: [authorId], references: [id])
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Vote {
  id        String   @id @default(uuid())
  value     Int
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("UserVotes", fields: [userId], references: [id])

  @@unique([userId, postId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("UserSavedPosts", fields: [userId], references: [id])

  @@unique([userId, postId])
}

model ModerationCache {
  id                    String           @id @default(uuid())
  publicId              String           @unique
  status                ModerationStatus
  moderationProvider    String           @default("Sightengine")
  nudityScore           Float?
  goreScore             Float?
  rawModerationResponse Json?
  moderatedAt           DateTime?
  createdAt             DateTime         @default(now())
}

model GameSession {
  id        String       @id @default(uuid())
  gameType  GameType
  status    GameStatus   @default(WAITING)
  gameState Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  moves     GameMove[]
  players   GamePlayer[]
  results   GameResult[]
}

model GamePlayer {
  id            String      @id @default(uuid())
  gameSessionId String
  userId        String
  nickname      String
  role          PlayerRole  @default(PLAYER)
  joinedAt      DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, userId])
}

model GameMove {
  id            String      @id @default(uuid())
  gameSessionId String
  playerId      String
  moveType      MoveType
  moveData      Json
  createdAt     DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
}

model GameResult {
  id              String      @id @default(uuid())
  gameSessionId   String
  winnerId        String?
  durationSeconds Int
  createdAt       DateTime    @default(now())
  gameSession     GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
}

enum NsfwMode {
  ALWAYS
  NEVER
  HIDE
  BLUR
  SHOW
}

enum ModerationStatus {
  SAFE
  SENSITIVE
  PENDING_MODERATION
  REJECTED
}

enum GameType {
  BLUFF
  TIC_TAC_TOE
  CONNECT_4
  CHESS
  UNO
  MEMORY_MATCH
  DOTS_AND_BOXES
  CAR_RACING
  BRAINROT_STACK
  YATZY
  COLOR_WARS
  SCRIBBLE
  INK_DECEPTION
  CHAMBER_CLASH
  FLAPPY_BIRD
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
}

enum PlayerRole {
  HOST
  PLAYER
  SPECTATOR
}

enum MoveType {
  PLAY_CARDS
  CHALLENGE_BLUFF
  PASS_TURN
  FLIP_CARD
  DRAW_LINE
  RACE_INPUT
  DROP_CHARACTER
  ROLL_DICE
  HOLD_DICE
  SELECT_CATEGORY
  SELECT_TILE
  SCRIBBLE_GUESS
  SCRIBBLE_SELECT_WORD
  INK_DECEPTION_SELECT_WORD
  INK_DECEPTION_GUESS
}

enum UserRole {
  USER
  SUPER_ADMIN
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  stars      Int
  content    String
  category   String
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String
  description String
  screenshot  String?
  browser     String?
  device      String?
  game        String?
  status      String   @default("OPEN") // OPEN, INVESTIGATING, IN_PROGRESS, FIXED, CLOSED
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserReport {
  id         String   @id @default(uuid())
  reporterId String
  reportedId String
  reason     String // TOXIC_CHAT, OFFENSIVE_USERNAME, CHEATING, EXPLOITING, OTHER
  details    String?
  status     String   @default("OPEN") // OPEN, CLOSED
  createdAt  DateTime @default(now())
  reporter   User     @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User     @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  description String
  color       String
  icon        String
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String
  target     String
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model GameConfig {
  id            String   @id
  isEnabled     Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  isMaintenance Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteConfig {
  id                 String   @id @default("default")
  registrationOpen   Boolean  @default(true)
  googleLoginEnabled Boolean  @default(true)
  maintenanceMode    Boolean  @default(false)
  ratingsEnabled     Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}
