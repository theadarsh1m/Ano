generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id
  nickname    String
  avatar      String?
  bio         String?
  email       String?   @unique
  googleId    String?   @unique
  isAnonymous Boolean   @default(true)
  isOnline    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  nsfwMode    NsfwMode  @default(HIDE)
  presenceStatus String?
  messages    Message[]

  // DM relations
  conversationsAsA Conversation[]  @relation("ParticipantA")
  conversationsAsB Conversation[]  @relation("ParticipantB")
  sentDMs          DirectMessage[] @relation("DMSender")

  // Notification relations
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")

  // Friendship relations
  friendshipsAsUser   Friendship[] @relation("FriendshipUser")
  friendshipsAsFriend Friendship[] @relation("FriendshipFriend")

  // Game relations
  gameStats           GameStat[]

  // Feed relations
  posts      Post[]      @relation("PostAuthor")
  comments   Comment[]   @relation("CommentAuthor")
  votes      Vote[]      @relation("UserVotes")
  savedPosts SavedPost[] @relation("UserSavedPosts")
}

model Room {
  id          String   @id
  name        String
  description String?
  type        String   @default("public")
  inviteCode  String?  @unique
  capacity    Int      @default(50)
  createdAt     DateTime       @default(now())
  createdBy     String?
  messages      Message[]
  voiceChannels VoiceChannel[]
}

model VoiceChannel {
  id        String   @id @default(uuid())
  name      String
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  capacity  Int      @default(25)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id
  content   String
  type      String   @default("text")
  createdAt DateTime @default(now())
  sender    User?    @relation(fields: [senderId], references: [id])
  senderId  String?
  room      Room     @relation(fields: [roomId], references: [id])
  roomId    String
  // Media fields (populated for image/file messages)
  fileUrl          String?
  fileName         String?
  fileSize         Int?
  fileType         String?  // MIME type e.g. "image/png", "application/pdf"
  moderationStatus ModerationStatus @default(PENDING)
  isNSFW           Boolean          @default(false)
  nsfwConfidence   Float            @default(0)
}

model Conversation {
  id             String          @id @default(uuid())
  participantAId String
  participantBId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  participantA   User            @relation("ParticipantA", fields: [participantAId], references: [id])
  participantB   User            @relation("ParticipantB", fields: [participantBId], references: [id])
  messages       DirectMessage[]

  @@unique([participantAId, participantBId])
}

model DirectMessage {
  id             String       @id @default(uuid())
  content        String
  type           String       @default("text")
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  senderId       String
  sender         User         @relation("DMSender", fields: [senderId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // Media fields
  fileUrl          String?
  fileName         String?
  fileSize         Int?
  fileType         String?
  moderationStatus ModerationStatus @default(PENDING)
  isNSFW           Boolean          @default(false)
  nsfwConfidence   Float            @default(0)
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  senderId    String?
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id])
  
  type        String   // e.g. "friend_request", "friend_accepted", "room_invite", "mention", "system", "activity"
  title       String
  message     String
  isRead      Boolean  @default(false)
  metadata    Json?    // Stores extra info like roomId, conversationId, etc.
  createdAt   DateTime @default(now())
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("FriendshipUser", fields: [userId], references: [id])
  friendId  String
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id])
  status    String   // "pending" or "accepted"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, friendId])
}

model GameStat {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType            String   // "snake", "2048", "minesweeper"
  highScore           Int      @default(0)
  totalPlayTimeSeconds Int     @default(0)
  lastPlayed          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, gameType])
}

// ========================
// COMMUNITY FEED MODELS
// ========================

model Post {
  id           String      @id @default(uuid())
  content      String?     // Text content
  imageUrl     String?     // Cloudinary image URL
  isAnonymous  Boolean     @default(false)
  score        Int         @default(0)  // Cached vote score
  authorId     String
  author       User        @relation("PostAuthor", fields: [authorId], references: [id])
  tags         String[]    @default([])
  commentCount Int         @default(0)
  isLocked     Boolean          @default(false) // Lock comments
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  moderationStatus ModerationStatus @default(PENDING)
  isNSFW           Boolean          @default(false)
  nsfwConfidence   Float            @default(0)

  votes    Vote[]
  comments Comment[]
  savedBy  SavedPost[]
}

model Comment {
  id          String    @id @default(uuid())
  content     String
  isAnonymous Boolean   @default(false)
  authorId    String
  author      User      @relation("CommentAuthor", fields: [authorId], references: [id])
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    String?   // null = top-level, set = nested reply
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vote {
  id        String   @id @default(uuid())
  value     Int      // +1 upvote, -1 downvote
  userId    String
  user      User     @relation("UserVotes", fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserSavedPosts", fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

enum NsfwMode {
  ALWAYS
  NEVER
  HIDE
  BLUR
  SHOW
}

enum ModerationStatus {
  PENDING
  SCANNING
  APPROVED
  FLAGGED
}

model ModerationCache {
  id             String           @id @default(uuid())
  publicId       String           @unique
  isNSFW         Boolean
  nsfwConfidence Float
  status         ModerationStatus
  createdAt      DateTime         @default(now())
}

enum GameType {
  BLUFF
  TIC_TAC_TOE
  CONNECT_4
  CHESS
  UNO
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
}

enum PlayerRole {
  HOST
  PLAYER
  SPECTATOR
}

enum MoveType {
  PLAY_CARDS
  CHALLENGE_BLUFF
  PASS_TURN
}

model GameSession {
  id             String       @id @default(uuid())
  gameType       GameType
  status         GameStatus   @default(WAITING)
  gameState      Json?        // Full serialized persistent state for server recovery
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  players        GamePlayer[]
  moves          GameMove[]
  results        GameResult[]
}

model GamePlayer {
  id             String       @id @default(uuid())
  gameSessionId  String
  gameSession    GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  userId         String
  nickname       String
  role           PlayerRole   @default(PLAYER)
  joinedAt       DateTime     @default(now())

  @@unique([gameSessionId, userId])
}

model GameMove {
  id             String       @id @default(uuid())
  gameSessionId  String
  gameSession    GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  playerId       String       // The player userId
  moveType       MoveType
  moveData       Json         // Public log details (never expose private cards/details)
  createdAt      DateTime     @default(now())
}

model GameResult {
  id             String       @id @default(uuid())
  gameSessionId  String
  gameSession    GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  winnerId       String?      // The winning userId
  durationSeconds Int
  createdAt      DateTime     @default(now())
}


